+    /* Pages written often get the same code bitmap the SMC path uses (every byte covered by a block on the
+     * page). A store that touches no covered byte cannot overlap a block, so the list walk can be skipped. */
+    if(p->code_bitmap == NULL && p->first_tb != NULL && ++p->code_write_count >= SMC_BITMAP_USE_THRESHOLD) {
+        build_page_bitmap(p);
+    }
+    if(p->code_bitmap != NULL) {
+        uint32_t offset = phys_pc & ~TARGET_PAGE_MASK;
+        uint32_t end = offset + access_width > TARGET_PAGE_SIZE ? TARGET_PAGE_SIZE : offset + access_width;
+        bool covered = false;
+        for(uint32_t i = offset; i < end; i++) {
+            if(p->code_bitmap[i >> 3] & (1 << (i & 7))) {
+                covered = true;
+                break;
+            }
+        }
+        if(!covered) {
+            return;
+        }
+    }
