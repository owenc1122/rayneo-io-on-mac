+//  ADD/SUB (immediate) when the constant, or its negation, fits in 12 bits. Register 31 means SP in this
+//  encoding but XZR in the register form, so it is left to the register form.
+static inline bool tcg_out_addsub_imm12(TCGContext *s, int bits, bool sub, int reg_dest, int reg_in, tcg_target_long imm)
+{
+    if(reg_dest == 31 || reg_in == 31) {
+        return false;
+    }
+    uint64_t mask = bits == 32 ? 0xffffffffull : ~0ull;
+    uint64_t k = (uint64_t)imm & mask, neg = (0 - (uint64_t)imm) & mask;
+    uint32_t sf = bits == 64 ? 0x80000000 : 0;
+    if(k < 4096) {
+        tcg_out32(s, sf | (sub ? 0x51000000 : 0x11000000) | ((uint32_t)k << 10) | (reg_in << 5) | reg_dest);
+        return true;
+    }
+    if(neg < 4096) {
+        tcg_out32(s, sf | (sub ? 0x11000000 : 0x51000000) | ((uint32_t)neg << 10) | (reg_in << 5) | reg_dest);
+        return true;
+    }
+    return false;
+}
