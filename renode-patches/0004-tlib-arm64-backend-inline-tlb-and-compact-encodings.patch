+//  Shortest MOVZ/MOVN + MOVK sequence for a 32- or 64-bit constant
+static inline void tcg_out_movi_short(TCGContext *s, int bits, int reg1, uint64_t value)
+{
+    int halfwords = bits / 16, zeros = 0, ones = 0;
+    for(int i = 0; i < halfwords; i++) {
+        uint32_t h = (value >> (16 * i)) & 0xffff;
+        zeros += h == 0;
+        ones += h == 0xffff;
+    }
+    bool inverted = ones > zeros;
+    uint32_t skip = inverted ? 0xffff : 0;
+    uint32_t sf = bits == 64 ? 0x80000000 : 0;
+    bool first = true;
+    for(int i = 0; i < halfwords; i++) {
+        uint32_t h = (value >> (16 * i)) & 0xffff;
+        if(h == skip) {
+            continue;
+        }
+        if(first) {
+            //  MOVN writes ~(imm16 << shift), MOVZ writes imm16 << shift
+            tcg_out32(s, sf | (inverted ? 0x12800000 : 0x52800000) | (i << 21) | ((inverted ? (~h & 0xffff) : h) << 5) | reg1);
+            first = false;
+        } else {
+            tcg_out32(s, sf | 0x72800000 | (i << 21) | (h << 5) | reg1);  //  MOVK
+        }
+    }
+    if(first) {
+        tcg_out32(s, sf | (inverted ? 0x12800000 : 0x52800000) | reg1);  //  all halfwords equal: 0 or ~0
+    }
+}
+
+static inline void tcg_out_movi64(TCGContext *s, int reg1, tcg_target_long imm)
+{
+    tcg_out_movi_short(s, 64, reg1, (uint64_t)imm);
+}
