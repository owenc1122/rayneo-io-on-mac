+//  LDR/STR with an immediate offset when it fits: scaled unsigned 12-bit, else unscaled signed 9-bit (LDUR/STUR)
+static inline bool tcg_out_ldst_imm(TCGContext *s, bool load, int bits, int reg_data, int reg_base, tcg_target_long offset)
+{
+    int size_log2 = bits == 8 ? 0 : bits == 16 ? 1 : bits == 32 ? 2 : 3;
+    uint32_t size_bits = (uint32_t)size_log2 << 30;
+    if(offset >= 0 && (offset & ((1 << size_log2) - 1)) == 0 && (offset >> size_log2) < 4096) {
+        tcg_out32(s, size_bits | (load ? 0x39400000 : 0x39000000) | ((offset >> size_log2) << 10) | (reg_base << 5) | reg_data);
+        return true;
+    }
+    if(offset >= -256 && offset < 256) {
+        tcg_out32(s, size_bits | (load ? 0x38400000 : 0x38000000) | ((offset & 0x1ff) << 12) | (reg_base << 5) | reg_data);
+        return true;
+    }
+    return false;
+}
+
