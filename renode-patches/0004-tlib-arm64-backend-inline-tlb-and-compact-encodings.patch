+//  Inline TLB lookup for guest loads and stores, as the i386 backend does: on a hit the access goes straight to
+//  host memory; anything else (miss, unaligned, MMIO, one-shot or not-dirty/code pages, all of which leave extra
+//  bits in the compared TLB word) takes the helper call. Uses R0-R2, which the qemu_ld/st constraints keep free.
+//  Returns the position of the branch to patch with the miss target, or NULL when the TLB is not used.
+static inline uint8_t *tcg_out_tlb_fast_path(TCGContext *s, int s_bits, bool load, bool sign_extend, int reg_data,
+                                             int reg_addr, int mem_index, uint8_t **done_branch)
+{
+    if(!s->use_tlb || TARGET_LONG_BITS != 32) {
+        return NULL;
+    }
+    int bits = 8 << s_bits;
+    //  w0 = addr & (page mask | alignment mask)
+    tcg_out_movi32(s, TCG_TMP_REG, (uint32_t)(TARGET_PAGE_MASK | ((1 << s_bits) - 1)));
+    tcg_out_and_reg(s, 32, TCG_REG_R0, reg_addr, TCG_TMP_REG);
+    //  x1 = env + ((addr >> page bits) & (tlb size - 1)) << entry bits  (UBFX w1, addr, #page bits, #tlb bits)
+    tcg_out32(s, 0x53000000 | (TARGET_PAGE_BITS << 16) | ((TARGET_PAGE_BITS + CPU_TLB_BITS - 1) << 10) | (reg_addr << 5) | TCG_REG_R1);
+    tcg_out32(s, 0x8b000000 | (TCG_REG_R1 << 16) | (CPU_TLB_ENTRY_BITS << 10) | (TCG_AREG0 << 5) | TCG_REG_R1);
+    //  w2 = entry.addr_read / addr_write; compare with w0
+    tcg_out_ld_offset(s, 32, false, TCG_REG_R2, TCG_REG_R1,
+                      tlb_table_n_0[mem_index] + (load ? tlb_entry_addr_read : tlb_entry_addr_write));
+    tcg_out_cmp(s, 32, TCG_REG_R0, TCG_REG_R2);
+    uint8_t *miss_branch = s->code_ptr;
+    tcg_out32(s, 0x54000000 | COND_NE);  //  b.ne miss, patched by the caller
+    //  x1 = entry.addend; access [x1 + zero-extended addr]
+    tcg_out_ld_offset(s, 64, false, TCG_REG_R1, TCG_REG_R1, tlb_table_n_0[mem_index] + tlb_entry_addend);
+    static const uint32_t ld_ops[] = { 0x38600800, 0x78600800, 0xb8600800, 0xf8600800 };
+    static const uint32_t st_ops[] = { 0x38200800, 0x78200800, 0xb8200800, 0xf8200800 };
+    //  option 010 = UXTW: the guest address is the low 32 bits of reg_addr
+    tcg_out32(s, (load ? ld_ops : st_ops)[s_bits] | (reg_addr << 16) | (0b010 << 13) | (TCG_REG_R1 << 5) | reg_data);
+    if(load && sign_extend) {
+        tcg_out_sign_extend(s, bits, reg_data, reg_data);
+    }
+    if(!load) {
+        //  Same ordering guarantee as the helper path below
+        tcg_out_mb(s, TCG_MO_ST_LD);
+    }
+    *done_branch = s->code_ptr;
+    tcg_out32(s, 0x14000000);  //  b done, patched by the caller
+    return miss_branch;
+}
+
+static inline void tcg_patch_branch(uint8_t *branch, uint8_t *target, bool conditional)
+{
+    int32_t offset = (int32_t)((target - branch) >> 2);
+    uint32_t insn = *(uint32_t *)branch;
+    if(conditional) {
+        insn |= (offset & 0x7FFFF) << 5;
+    } else {
+        insn |= offset & 0x3FFFFFF;
+    }
+    *(uint32_t *)branch = insn;
+}
+
 //  qemu_st/ld loads and stores to and from GUEST addresses, not host ones
 static inline void tcg_out_qemu_st(TCGContext *s, int bits, int reg_data, int reg_addr, int mem_index)
 {
+    uint8_t *done_branch = NULL;
+    int s_bits = bits == 8 ? 0 : bits == 16 ? 1 : bits == 32 ? 2 : 3;
+    uint8_t *miss_branch = tcg_out_tlb_fast_path(s, s_bits, false, false, reg_data, reg_addr, mem_index, &done_branch);
+    if(miss_branch) {
+        tcg_patch_branch(miss_branch, s->code_ptr, true);
+    }
     //  Store #bits number of bits from reg_data into the guest address in reg_addr
     //
     //  Clobbers R0, R1, and R2 since we need extra scratch registers
@@ -1150,10 +1311,19 @@ static inline void tcg_out_qemu_st(TCGContext *s, int bits, int reg_data, int re
     //  Needed to make sure atomic instructions using this works correctly
     //  ST-LD barrier because we only need the store to be visible to future loads
     tcg_out_mb(s, TCG_MO_ST_LD);
+    if(done_branch) {
+        tcg_patch_branch(done_branch, s->code_ptr, false);
+    }
 }
 
